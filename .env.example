# Parent PIN for /setup. Pick something the birthday kid can't guess.
SETUP_PIN=

# Signs the parent's login cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set automatically when you connect Upstash Redis via the Vercel Marketplace.
# Leave empty locally to use a JSON file in .data/ instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set automatically when you connect a Vercel Blob store.
# Leave empty locally to store uploads in .data/uploads/ instead.
BLOB_READ_WRITE_TOKEN=

# Optional: the public URL printed into QR codes. Defaults to the request's own host.
# NEXT_PUBLIC_SITE_URL=https://your-hunt.vercel.app
